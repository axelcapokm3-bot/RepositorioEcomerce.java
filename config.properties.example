# Copiar este archivo como src/main/resources/config.properties y completar
# los valores con credenciales propias. No guardar secretos reales aquí.
db.url=jdbc:mysql://localhost:3306/ecommerce_db?serverTimezone=UTC&useSSL=false
db.username=root
db.password=CAMBIAR_POR_TU_PASSWORD
db.maximumPoolSize=10

# Mercado Pago
mercadopago.access-token=REEMPLAZAR_POR_TU_ACCESS_TOKEN
mercadopago.public-key=REEMPLAZAR_POR_TU_PUBLIC_KEY
mercadopago.webhook-secret=REEMPLAZAR_POR_TU_SECRETO_WEBHOOK
# URL HTTPS pública del frontend expuesta por Caddy/ngrok; usar el host vigente del túnel.
# mercadopago.public-base-url=https://<host-ngrok-actual>/<ruta-publica-del-frontend>
# Alternativa: definir MERCADOPAGO_PUBLIC_BASE_URL en el entorno del proceso Java.
# mercadopago.checkout-return-url también se admite como alias.

# Stripe (usar claves de prueba en desarrollo)
stripe.secret-key=sk_test_REEMPLAZAR_POR_TU_SECRET_KEY
stripe.public-key=pk_test_REEMPLAZAR_POR_TU_PUBLIC_KEY
stripe.webhook-secret=whsec_REEMPLAZAR_POR_TU_SECRETO_WEBHOOK
stripe.success-url=http://localhost:5500/index.html?view=checkout-return&session_id={CHECKOUT_SESSION_ID}
stripe.cancel-url=http://localhost:5500/index.html?view=checkout-return&resultado=failure

# URLs del sistema
app.frontend.url=http://localhost:5500
app.backend.url=http://localhost:8080

# CORS: orígenes permitidos separados por coma. No usar '*'.
app.cors.allowed-origins=http://localhost:5500,http://localhost:8080

# Autenticación: preferir las variables de entorno AUTH_TOKEN_SECRET y AUTH_EXPIRACION_HORAS.
# El secreto debe tener al menos 32 caracteres. Si no se configura, el servidor genera
# uno efímero SOLO en perfil desarrollo y los tokens se invalidan al reiniciar.
# En producción (APP_PERFIL=prod) el arranque falla sin AUTH_TOKEN_SECRET.
# auth.token-secret=REEMPLAZAR_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
# auth.expiracion-horas=12
# Perfil: dev (local) o prod. En prod, el secreto de tokens es obligatorio.
# app.perfil=dev
# Token de uso único para crear el primer ADMIN vía POST /api/auth/registro
# (header X-Setup-Token). Definirlo solo durante el bootstrap y eliminarlo después.
# auth.bootstrap-token=REEMPLAZAR_POR_TOKEN_TEMPORAL
